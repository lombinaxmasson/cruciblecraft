{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.invalid/schema/t42-owner-object-expression-evidence.json",
  "type": "object",
  "required": ["schema_version", "status", "approvals"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "T42_OWNER_OBJECT_EXPRESSION_EVIDENCE" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "future_owner",
          "object_boundary_root_sha256",
          "runtime_behavior_root_sha256",
          "recheck_condition"
        ],
        "properties": {
          "family_id": { "type": "string" },
          "future_owner": {
            "type": "string",
            "pattern": "^later:object_expression/.+"
          },
          "object_boundary_root_sha256": { "type": "string" },
          "runtime_behavior_root_sha256": { "type": "string" },
          "recheck_condition": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
