{
  "$id": "https://cruciblecraft.dev/schema/unified_recipe_compile_readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failed_gates": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "generated_by": {
      "type": "string"
    },
    "identity_semantic_root_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "owns_families": {
      "const": 0
    },
    "rebuilds_identical": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "UNIFIED_RECIPE_COMPILE_READY",
        "UNIFIED_RECIPE_COMPILE_BLOCKED"
      ]
    },
    "typed_identity_blocker_count": {
      "type": "integer"
    },
    "wave_bindings": {
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "status",
    "owns_families",
    "gates",
    "failed_gates"
  ],
  "title": "CrucibleCraft unified recipe compile-authority cutover readiness",
  "type": "object"
}
