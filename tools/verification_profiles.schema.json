{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification_profiles.schema.json",
  "title": "CrucibleCraft active verification profiles",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "unmatched_policy",
    "active_profiles",
    "release_profiles",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "type": "string"
    },
    "unmatched_policy": {
      "const": "report"
    },
    "documentation_path_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "historical_receipt_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "active_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "release_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "tier",
          "datagen",
          "gradle_tasks",
          "python_modules",
          "builders",
          "owned_paths"
        ],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "dev",
              "integration",
              "release"
            ]
          },
          "datagen": {
            "type": "boolean"
          },
          "gradle_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "python_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^test_[A-Za-z0-9_]+$"
            },
            "uniqueItems": true
          },
          "builders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "owned_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
