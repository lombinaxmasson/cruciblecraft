      }
    },
    "coated_exclusion_with_wrench_exception": {
      "reason": "Core, hammer, File, Chisel, Saw, and Screwdriver listeners include TD.Coated.NOT; the Wrench listener at line 310 and the Wire Cutter listener at line 324 do not. Gilded/coated material is therefore valid for Wrench and Wire Cutter only when their other gates pass.",
      "observed_tag_population": 5,
      "source": {
        "repository": "GregTech6/gregtech6",
        "revision": "3703e40308c8c030763fd6297dea8b210d2a77b1",
        "path": "src/main/java/gregtech/loaders/a/Loader_Tools.java",
        "included_lines": "295-307, 321, 327",
        "wrench_omission_line": "310"
      }
    },
    "exact_wood_exclusion": {
      "reason": "MT.Wood.NOT is object-identity negation and excludes only exact MT.Wood, not every material carrying PROPERTIES.WOOD.",
      "source": {
        "repository": "GregTech6/gregtech6",
        "revision": "3703e40308c8c030763fd6297dea8b210d2a77b1",
        "condition_path": "src/main/java/gregapi/oredict/OreDictMaterial.java",
