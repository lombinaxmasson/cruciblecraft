        "use_lines": "295-327"
      }
    },
    "hammer_wood_exclusion": {
      "reason": "Hammer prefix/listener/full-tool gates intersect so WOOD materials cannot produce the complete hammer even though the prefix condition also mentions WOOD in its disjunction.",
      "observed_tag_population": 128,
      "source": {
        "repository": "GregTech6/gregtech6",
