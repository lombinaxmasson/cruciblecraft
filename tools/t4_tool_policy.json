      }
    },
    "bouncy_exclusion_with_screwdriver_exception": {
      "reason": "Hammer, File, Chisel, Saw, and Wrench source gates exclude BOUNCY. Screwdriver OP.java:248 and Loader_Tools.java:306 omit that predicate, so the runtime must not interpolate it from adjacent workshop tools.",
      "observed_tag_population": 6,
      "source": {
        "repository": "GregTech6/gregtech6",
