{
  "schema_version": 1,
  "source_revision": "local-gt6-tfru-and-ktfruaddon",
  "purpose": "Source-backed Waila to Jade migration ledger. This file describes observable rows; it does not register Jade providers.",
  "source_trees": [
    "gt6_tfru/gregtech6-TFRU/src/main/java",
    "ktfruaddon/kTFRUAddon/src/main/java"
  ],
  "protocol": {
    "waila_registration": "gregapi.compat.waila.CompatWaila.callbackRegister",
    "registration_scope": "IWailaTile.class",
    "callbacks": [
      "getWailaStack",
      "getWailaHead",
      "getWailaBody",
      "getWailaTail",
      "getWailaNBT"
    ],
    "jade_projection": {
      "server_data": "IServerDataProvider<BlockAccessor>.appendServerData",
      "client_rows": "IBlockComponentProvider.appendTooltip",
      "source_data_policy": "Do not invent rows absent from the Waila contract."
    }
  },
  "color_tokens": {
    "value_white": "LH.Chat.WHITE",
    "unit_cyan": "LH.Chat.CYAN",
    "state_forced_stop": "LH.Chat.YELLOW",
    "state_active": "LH.Chat.GREEN",
    "state_passive": "LH.Chat.BLUE",
    "state_ready": "LH.Chat.GREEN",
    "state_stopped": "LH.Chat.RED",
    "state_power_saving": "LH.Chat.CYAN",
    "item_section_cyan": "LH.Chat.CYAN",
    "item_efficiency_yellow": "LH.Chat.YELLOW",
    "item_input_green": "LH.Chat.GREEN",
    "item_output_red": "LH.Chat.RED",
    "item_warning_orange": "LH.Chat.ORANGE",
    "item_hazard_dark_red": "LH.Chat.DRED",
    "item_hint_dark_gray": "LH.Chat.DGRAY"
  },
  "standard_rows": {
    "state": {
      "provider": "IWailaTile.instanceInfoState",
      "server_keys": [
        {
          "key": "gt.waila.state",
          "type": "byte",
          "source": "InfoState.getState(TileEntity)"
        }
      ],
      "state_colors": {
        "stopped_force": "state_forced_stop",
        "active": "state_active",
        "passive": "state_passive",
        "ready": "state_ready",
        "stopped": "state_stopped",
        "power_saving": "state_power_saving"
      },
      "jade_section": "state"
    },
    "energy_io_range": {
      "provider": "IWailaTile.instanceInfoEnergyIORange",
      "source": "ITileEntityEnergy.getEnergySizeInputMin/Max and getEnergySizeOutputMin/Max",
      "row_shape": "ENERGY_INPUT/ENERGY_OUTPUT + min-max + energy type + /A",
      "value_color": "value_white",
      "amperage_color": "unit_cyan",
      "jade_section": "energy_io_range"
    },
    "energy_io_recommended": {
      "provider": "IWailaTile.instanceInfoEnergyIORec",
      "source": "ITileEntityEnergy.getEnergySizeInputRecommended/getEnergySizeOutputRecommended",
      "row_shape": "ENERGY_INPUT/ENERGY_OUTPUT + recommended value + energy type + /A",
      "value_color": "value_white",
      "jade_section": "energy_io_recommended"
    },
    "tank": {
      "provider": "IWailaTile.InfoTank or IWailaTile.addTankDesc",
      "row_shape": "prefix + amount/capacity + L + localized fluid name",
      "amount_color": "value_white",
      "unit_color": "unit_cyan",
      "fluid_name_color": "value_white",
      "jade_section": "fluid_tanks"
    },
    "fluid_stack": {
      "provider": "IWailaTile.addFluidStackDesc",
      "row_shape": "prefix + amount + L + localized fluid name",
      "amount_color": "value_white",
      "unit_color": "unit_cyan",
      "fluid_name_color": "value_white",
      "jade_section": "fluid_output"
    },
    "energy_amount": {
      "provider": "IWailaTile.addEnergyAmountDesc",
      "row_shape": "prefix + amount + localized energy type",
      "amount_color": "value_white",
      "jade_section": "energy_buffer"
    }
  },
