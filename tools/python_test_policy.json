{
  "schema_version": 1,
  "default_suite": "fast",
  "closure_only_test_patterns": [
    "test_full_verification_report.*",
    "*.test_check_mode_is_immutable",
    "*.test_check_modes_do_not_modify_*",
    "*.test_committed_report_matches_current_tooling_snapshot",
    "*.test_committed_outputs_are_current",
    "*.test_generation_is_deterministic",
    "*.test_repository_outputs_are_byte_exact"
  ],
  "source_replay_test_patterns": [
    "*.test_assembler_and_press_reference_samples_keep_fixed_inputs",
    "*.test_committed_verdicts_cover_every_normalized_cc_recipe",
    "*.test_generic_intentional_boilerplate_is_unreviewed",
    "*.test_automated_review_requires_current_evidence_digest",
    "*.test_human_review_requires_durable_attribution",
    "*.test_committed_non_exact_rows_have_row_specific_evidence",
    "test_build_t5_chemical_recipes.*.test_full_replay_generation_is_deterministic",
    "test_build_t5_distillery_projection.*.test_source_and_every_row_hash_are_pinned",
    "test_build_t11_preflight_projection.*.test_selected_source_row_hashes_match_raw_dump",
    "test_build_t13_prefix_domain_denominators.*",
    "test_gt6_generation_bits.*",
    "test_gt6_l1b_layer_select.*.test_protons_cross_validate_but_do_not_classify_identity",
    "test_gt6_l1b_layer_select.*.test_reference_metadata_tracks_sentinel_compatibility_surface",
    "test_gt6_l3_materials.*",
    "test_gt6_recipe_templates.*"
  ],
  "prechecked_stage_test_patterns": {
    "CRUCIBLECRAFT_BUILDER_STAGE_PASSED": [
      "test_import_gt6_oredict.*.test_check_modes_do_not_modify_import_artifacts",
      "test_compare_gt6_recipes.*.test_check_modes_do_not_modify_audit_artifacts",
      "test_build_component_rules.*.test_repository_outputs_are_byte_exact",
      "test_build_gt6_ore_chain.*.test_committed_outputs_are_current_without_reference_rebuild",
      "test_build_gt6_material_form_gate.*.test_committed_outputs_are_current_without_raw_replay",
      "test_build_t4_tool_readiness.*.test_committed_ledger_matches_current_sources_and_policy",
      "test_build_t5_chemical_readiness.*.test_committed_ledger_is_current_and_deterministic",
      "test_build_t5_distillery_projection.*.test_check_mode_is_deterministic_and_read_only",
      "test_build_machine_crafting_readiness.*.test_committed_ledger_is_current_and_deterministic",
      "test_build_t6_electrical_readiness.*.test_committed_ledger_is_current_and_check_mode_is_read_only",
