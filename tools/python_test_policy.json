      "test_build_t10_container_readiness.*.test_committed_outputs_are_current",
      "test_apply_t10_form_flags.*.test_committed_material_projection_is_current",
      "test_build_t11_preflight_projection.*.test_committed_artifacts_are_current_and_check_is_read_only",
