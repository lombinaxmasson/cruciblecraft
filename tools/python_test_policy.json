    "*.test_human_review_requires_durable_attribution",
    "*.test_committed_non_exact_rows_have_row_specific_evidence",
    "test_build_t5_chemical_recipes.*.test_full_replay_generation_is_deterministic",
    "test_build_t5_distillery_projection.*.test_source_and_every_row_hash_are_pinned",
