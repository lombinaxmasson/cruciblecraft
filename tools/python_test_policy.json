      "test_build_t12_machine_readiness.*.test_committed_historical_readiness_check_is_immutable",
      "test_build_t12_closure_readiness.*.test_committed_readiness_is_current",
      "test_build_t13_prefix_domain_denominators.*.test_committed_artifacts_are_current",
      "test_build_t13_machine_energy_denominators.*.test_committed_artifacts_are_current_and_check_is_immutable",
      "test_build_t13_cover_multiblock_denominators.*.test_committed_tables_are_current_and_check_is_read_only",
