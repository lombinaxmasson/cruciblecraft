{
  "class_definitions": [
    {
      "class": "equivalence_crushed_ore",
      "definition": "GT6 ore meta items (broken ore x host-rock variants and normal ore x host-rock variants) are the same physical form as the CC crushed_ore prefix. GT6's 22 host rocks are a GT6 worldgen setting; CC generates only stone/deepslate hosts (T9 policy). The host-rock suffix does not change the operand semantics of the recipe.",
      "discriminant": [
        "gregtech:gt.meta.ore.broken.",
        "gregtech:gt.meta.ore.normal."
      ],
      "recheck_point": "T9 host-rock policy changes (CC adds host-rock variants).",
      "target_form": "cruciblecraft:crushed_ore"
    },
    {
      "class": "out_of_scope_packaging_form",
      "definition": "GT6 64x crate items are a logistics packaging layer (bulk transport compression). CC does not implement crate packaging and it is G10 peripheral. Recipes referencing crates are GT6 bulk-logistics rows, not process recipes.",
      "discriminant": [
        "gregtech:gt.meta.crate."
      ],
      "recheck_point": "CC implements bulk packaging / crate logistics.",
      "target_form": null
    },
    {
      "class": "out_of_scope_machine_item_variant",
      "definition": "GT6 machine meta items (machine, machine.dense/double/quadruple) are machine-item variants of the T12/T16 machine identity system, not recipe operands. Machine items are not material-prefix pairs and are not handled by recipe operand projection.",
      "discriminant": [
        "gregtech:gt.meta.machine"
      ],
      "recheck_point": "T12/T16 machine identity system covers GT6 machine items.",
      "target_form": null
    },
    {
      "class": "equivalence_block_variant",
      "definition": "GT6 storage.ingot (9-ingot storage block) is the CC block prefix (units 1296 = 9 x 144, capability cruciblecraft:storage).",
      "discriminant": [
        "gregtech:gt.meta.storage.ingot"
      ],
      "recheck_point": "CC block prefix semantics change.",
      "target_form": "cruciblecraft:block"
    },
    {
      "class": "equivalence_dense_plate",
      "definition": "GT6 storage.plate (9-plate compressed plate block) is the CC dense_plate prefix (units 1296 = 9 x 144).",
      "discriminant": [
        "gregtech:gt.meta.storage.plate"
      ],
      "recheck_point": "CC dense_plate prefix semantics change.",
      "target_form": "cruciblecraft:dense_plate"
    },
    {
      "class": "out_of_scope_storage_variant",
      "definition": "GT6 storage blocks for forms CC does not compress: dust, gem, plateGem and raw storage blocks have no CC prefix equivalent (CC has no dust/gem/plateGem/raw block prefixes). These are compression forms of the GT6 storage layer.",
      "discriminant": [
        "gregtech:gt.meta.storage.dust",
        "gregtech:gt.meta.storage.gem",
        "gregtech:gt.meta.storage.plateGem",
        "gregtech:gt.meta.storage.raw"
      ],
      "recheck_point": "CC adds dust/gem/plateGem/raw storage block prefixes.",
      "target_form": null
    }
  ],
