{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/recipe_load_projection.schema.json",
  "title": "CrucibleCraft family recipe load projection",
  "description": "T14d input contract. Every family count and measurement interval is explicit; ratio inputs and inferred counts are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "projection_id",
    "delivery_phase",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "FAMILY_LOAD_PROJECTION_INPUT"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "delivery_phase": {
      "enum": [
        "T14",
        "T15",
        "T16",
        "T17",
        "T18",
        "T19"
      ]
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "$defs": {
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "max": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "canonical_ids",
        "strategy",
        "authored_entries",
        "logical_rows",
        "eager_publication_rows",
        "lazy_logical_rows",
        "lazy_cache_ceiling_rows",
        "sync_bytes",
        "measurement_basis",
        "measurement_intervals"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "canonical_ids": {
          "description": "Canonical normalized_row_key values from tools/t13_denominators/recipe_maps.json. Only in_scope rows are accepted by the projector.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strategy": {
          "enum": [
            "immediate",
            "on_demand",
            "hybrid"
          ]
        },
        "authored_entries": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "logical_rows": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "eager_publication_rows": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "lazy_logical_rows": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "lazy_cache_ceiling_rows": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "sync_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "measurement_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "measured_logical_rows"
          ],
          "properties": {
            "kind": {
              "enum": [
                "family_specific_measurement",
                "zero_workload_fixture"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "measured_logical_rows": {
              "description": "Exact family workload scales that were measured. The projector requires logical_rows to be one of these points and never extrapolates.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonnegative_integer"
              }
            }
          }
        },
        "measurement_intervals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server_reload_ms",
            "server_index_ms",
            "client_reload_ms",
            "client_index_ms",
            "retained_memory_bytes",
            "allocation_bytes",
            "lookup_p95_ns",
            "lookup_candidate_count"
          ],
          "properties": {
            "server_reload_ms": {
              "$ref": "#/$defs/interval"
            },
            "server_index_ms": {
              "$ref": "#/$defs/interval"
            },
            "client_reload_ms": {
              "$ref": "#/$defs/interval"
            },
            "client_index_ms": {
              "$ref": "#/$defs/interval"
            },
            "retained_memory_bytes": {
              "$ref": "#/$defs/interval"
            },
            "allocation_bytes": {
              "$ref": "#/$defs/interval"
            },
            "lookup_p95_ns": {
              "$ref": "#/$defs/interval"
            },
            "lookup_candidate_count": {
              "$ref": "#/$defs/interval"
            }
          }
        }
      }
    }
  }
}
