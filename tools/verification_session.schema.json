{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schemas/verification-session.schema.json",
  "title": "CrucibleCraft full verification session",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "created_at",
    "updated_at",
    "identity",
    "context",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "required": [
        "tooling_snapshot_sha256",
        "python_test_policy_sha256",
        "builder_policy_sha256",
        "toolchain_sha256",
        "source_replay"
      ],
      "properties": {
        "tooling_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_test_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "builder_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_replay": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "context_sha256"
          ],
          "properties": {
            "path": {
              "const": "validation-context.json"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "context_sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "steps": {
      "type": "object",
      "required": [
        "builder",
        "datagen_1",
        "datagen_2",
        "java",
        "gametest",
        "python",
        "report"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "step": {
      "type": "object",
      "required": [
        "status",
        "attempts",
        "evidence",
        "evidence_sha256",
        "error"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "FAILED",
            "PASSED"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
