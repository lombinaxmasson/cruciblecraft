  "principle": "Every class is a category definition with a discriminant and a recheck point. A reason is never \"cannot translate\".",
  "classes": [
    {
      "class": "hosted_ore_block",
      "definition": "GT6 ore.normal.<rock> and ore.broken.<rock> are rock-hosted blocks, not crushed_ore items. CC has explicit hosted and rock-host identities; only a source-specific hosted/block alias may map them, and unresolved variants remain blocked.",
      "discriminant": [
        "gregtech:gt.meta.ore.broken.",
        "gregtech:gt.meta.ore.normal."
      ],
      "target_form": null,
      "recheck_point": "A source-backed CC hosted/block identity exists for the exact host and meta."
    },
    {
      "class": "out_of_scope_packaging_form",
      "definition": "GT6 64x crate items are a logistics packaging layer (bulk transport compression). CC does not implement crate packaging and it is G10 peripheral. Recipes referencing crates are GT6 bulk-logistics rows, not process recipes.",
      "discriminant": [
        "gregtech:gt.meta.crate."
      ],
      "target_form": null,
      "recheck_point": "CC implements bulk packaging / crate logistics."
    },
    {
      "class": "equivalence_machine_casing",
      "definition": "GT6 gt.meta.machine is OP.casingMachine and maps to the CC machine_casing material form.",
      "discriminant": [
        "gregtech:gt.meta.machine"
      ],
      "target_form": "cruciblecraft:machine_casing",
      "recheck_point": "CC machine_casing prefix semantics change."
