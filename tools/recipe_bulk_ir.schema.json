{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/recipe_bulk_ir.schema.json",
  "title": "CrucibleCraft recipe bulk IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "families"
  ],
  "properties": {
    "archetype": { "type": "string" },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_family_id",
          "template_kind",
          "source_rows",
          "relations"
        ],
        "properties": {
          "cardinality_proof": { "type": ["object", "null"] },
          "family_kind": { "type": "string" },
          "lock_row": { "type": ["object", "null"] },
          "provenance": { "type": "object" },
          "publication_group": { "type": ["string", "null"] },
          "relative_path": { "type": "string" },
          "relations": { "type": "array" },
          "resolved_operands": { "type": "array" },
          "semantic_family_id": { "type": "string" },
          "source_revision": { "type": "string" },
          "source_rows": { "type": "array" },
          "target_map": { "type": "string" },
          "template_kind": {
            "enum": [
              "exact_singleton",
              "exact_relation_set",
              "finite_bindings",
              "keyed_join"
            ]
          }
        }
      }
    },
    "lock_path": { "type": ["string", "null"] },
    "lock_sha256": { "type": ["string", "null"] },
    "schema_version": { "const": 1 },
    "source_path": { "type": "string" },
    "source_revision": { "type": "string" },
    "source_sha256": { "type": "string" },
    "target_map": { "type": "string" },
    "template_kind": { "type": "string" },
    "wave_id": { "type": "string" }
  }
}
