{
  "$id": "https://cruciblecraft.dev/schema/unified_import_shadow_readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failed_gates": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "generated_by": {
      "type": "string"
    },
    "identity_semantic_root_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "owns_families": {
      "const": 0
    },
    "rebuilds_identical": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "UNIFIED_IMPORT_SHADOW_READY",
        "UNIFIED_IMPORT_SHADOW_BLOCKED"
      ]
    },
    "typed_identity_blocker_count": {
      "minimum": 0,
      "type": "integer"
    },
    "wave_bindings": {
      "items": {
        "properties": {
          "byte_identity": {
            "type": "boolean"
          },
          "family_count": {
            "type": "integer"
          },
          "generated_tree_sha256": {
            "type": "string"
          },
          "relation_count": {
            "type": "integer"
          },
          "stable_id_sha256": {
            "type": "string"
          },
          "wave_id": {
            "type": "string"
          }
        },
        "required": [
          "wave_id",
          "stable_id_sha256",
          "family_count",
          "relation_count"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "status",
    "owns_families",
    "gates",
    "failed_gates"
  ],
  "title": "CrucibleCraft unified import shadow readiness",
  "type": "object"
}
