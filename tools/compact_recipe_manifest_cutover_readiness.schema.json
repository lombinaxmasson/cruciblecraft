{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/compact_recipe_manifest_cutover_readiness.schema.json",
  "title": "CrucibleCraft compact recipe runtime-manifest cutover readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "owns_families", "gates", "failed_gates"],
  "properties": {
    "failed_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "generated_by": { "type": "string" },
    "note": { "type": "string" },
    "owns_families": { "const": 0 },
    "schema_version": { "const": 1 },
    "status": {
      "enum": [
        "COMPACT_RECIPE_MANIFEST_CUTOVER_READY",
        "COMPACT_RECIPE_MANIFEST_CUTOVER_BLOCKED"
      ]
    }
  }
}
