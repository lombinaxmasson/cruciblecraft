{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/machine_delivery.schema.json",
  "title": "CrucibleCraft processing machine delivery sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision",
    "hosts",
    "texture_aliases",
    "shaped_models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_revision": {
      "const": "3703e40308c8c030763fd6297dea8b210d2a77b1"
    },
    "note": {
      "type": "string"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "texture_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "shaped_models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recipe_map",
        "spec_family",
        "energy",
        "slots",
        "gt6_panel",
        "texture_profile",
        "gt6_source",
        "art_destination",
        "kind_catalog"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cruciblecraft:[a-z0-9_]+$"
        },
        "recipe_map": {
          "type": "string",
          "pattern": "^cruciblecraft:[a-z0-9_]+$"
        },
        "spec_family": {
          "enum": [
            "opening",
            "primary",
            "component",
            "chemical",
            "hydrocarbon",
            "laser"
          ]
        },
        "energy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mode"
          ],
          "properties": {
            "type": {
              "enum": [
                "HEAT",
                "KINETIC",
                "KINETIC_ROTATION",
                "KINETIC_PUSH",
                "ELECTRIC",
                "LU",
                "TIME",
                "QUANTUM",
                "CU",
                "MU"
              ]
            },
            "mode": {
              "enum": [
                "BUFFERED",
                "ADJACENT"
              ]
            }
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_inputs",
            "item_outputs",
            "fluid_inputs",
            "fluid_outputs"
          ],
          "properties": {
            "item_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "item_outputs": {
              "type": "integer",
              "minimum": 0
            },
            "fluid_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "fluid_outputs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gt6_panel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in_items",
            "out_items",
            "in_fluids",
            "out_fluids"
          ],
          "properties": {
            "in_items": {
              "type": "integer",
              "minimum": 0
            },
            "out_items": {
              "type": "integer",
              "minimum": 0
            },
            "in_fluids": {
              "type": "integer",
              "minimum": 0
            },
            "out_fluids": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "texture_profile": {
          "type": "string",
          "minLength": 1
        },
        "gt6_source": {
          "type": "string",
          "minLength": 1
        },
        "art_destination": {
          "type": "string",
          "minLength": 1
        },
        "kind_catalog": {
          "type": "boolean"
        }
      }
    }
  }
}
