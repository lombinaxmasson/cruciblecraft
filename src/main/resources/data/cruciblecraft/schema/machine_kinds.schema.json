{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/machine_kinds.schema.json",
  "title": "CrucibleCraft processing kind acquisition and language",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "kinds", "material_lang"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "source_revision": {
      "const": "3703e40308c8c030763fd6297dea8b210d2a77b1"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "acquisition_template",
          "lang_key_zh",
          "lang_key_en"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cruciblecraft:[a-z0-9_]+$"
          },
          "acquisition_template": {
            "enum": [
              "centrifuge",
              "kinetic",
              "heat",
              "electrolyzer",
              "compressor",
              "sifter",
              "canner",
              "machine_generic",
              "slicer",
              "laminator",
              "melter",
              "pressurewasher",
              "loom",
              "electricloom",
              "injector",
              "nanofab",
              "oven",
              "none"
            ]
          },
          "lang_key_zh": { "type": "string", "minLength": 1 },
          "lang_key_en": { "type": "string", "minLength": 1 },
          "display_group": { "enum": ["kinetic", "heat"] }
        }
      }
    },
    "material_lang": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang_key_zh", "lang_key_en"],
        "properties": {
          "lang_key_zh": { "type": "string", "minLength": 1 },
          "lang_key_en": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
