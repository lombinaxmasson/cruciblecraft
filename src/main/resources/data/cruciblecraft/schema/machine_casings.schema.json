{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruciblecraft.dev/schema/machine_casings.schema.json",
  "title": "CrucibleCraft machine casing extras",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "source_revision": {
      "const": "3703e40308c8c030763fd6297dea8b210d2a77b1"
    },
    "electrolyzer_cables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material", "cable_material"],
        "properties": {
          "material": {
            "type": "string",
            "pattern": "^cruciblecraft:[a-z0-9_]+$"
          },
          "cable_material": { "type": "string", "minLength": 1 }
        }
      }
    },
    "machine_material_extras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material",
          "distillery_wire_material",
          "distillery_wire_prefix"
        ],
        "properties": {
          "material": {
            "type": "string",
            "pattern": "^cruciblecraft:[a-z0-9_]+$"
          },
          "distillery_wire_material": { "type": "string", "minLength": 1 },
          "distillery_wire_prefix": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
