{
  "required": true,
  "package": "com.masson.cruciblecraft.mixin",
  "plugin": "com.masson.cruciblecraft.mixin.CrucibleCraftMixinPlugin",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "ClientRecipePacketTimingMixin",
    "GenericPacketSplitterSizeLimitsMixin",
    "ItemStackMixin",
    "RecipeManagerWorkbenchToolsMixin"
  ],
  "client": [
    "ClientRecipeSyncTimingMixin",
    "EmiVanillaPluginTimingMixin",
    "RemiStackGroupFields",
    "RemiStackGroupLockMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
